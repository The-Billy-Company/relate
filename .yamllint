# GitHub Actions is the YAML surface here. Correctness stays strict; workflow
# expressions and command lines get room to remain readable.
---
extends: default

ignore: |
  **/target/**
  **/.venv/**
  **/.zig-cache/**
  **/zig-out/**
  **/zig-pkg/**

rules:
  document-start: disable
  line-length:
    max: 200
    level: warning
    allow-non-breakable-words: true
  truthy:
    allowed-values: ["true", "false", "on", "off"]
    check-keys: false
  comments:
    require-starting-space: true
    min-spaces-from-content: 1
  comments-indentation: disable
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1
  indentation:
    spaces: consistent
    indent-sequences: consistent
  key-duplicates: enable
  trailing-spaces: enable
  new-lines: enable
  empty-lines:
    max: 2
    max-start: 0
    max-end: 1
