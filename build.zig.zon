.{
    .name = .relate,
    .version = "1.1.2", // x-release-please-version
    .fingerprint = 0xe89435dd16b21037,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Sibling-checkout path dep (dev). Releases pin url+hash via the
        // publish script — see the ecosystem split plan.
        .irregex = .{ .path = "../irregex" },
        // The shard-aware test runner (build-time only, no artifact, no ABI).
        // Reached directly rather than through `irregex`, which used to carry
        // a copy of it. Pinned rather than path-dep'd, unlike the siblings
        // above: those are co-developed and land together, so a checkout beside
        // this one is the point, while the runner is a published package whose
        // version this repository should choose deliberately.
        .brigade = .{
            .url = "https://github.com/The-Billy-Company/brigade/archive/refs/tags/v0.1.0.tar.gz",
            .hash = "brigade-0.1.0-1n1fSXIlAQC4kvSlWxrMgJPZe61yl2IDWzes5LNPLvo4",
        },
        .gist = .{ .path = "../gist" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "NOTICE",
    },
}
