// relate — import topology.
//
// The compression-as-search engine of the irregex ecosystem, plus the
// `relate` binary that ships it: kinship metrics, unit anatomy, the cento
// quoter over irregex's FM-index, the persisted kinship artifacts, the
// retrieval path over them, the face/CLI vocabulary that turns those into a
// product, and the C-ABI producer (`librelate` / `relate_run`). The
// exact-search library beneath (including the FM-index and its shelf) is the
// `irregex` module; the resident daemon and answer keep the face dials are
// the `gist` module — both reached only through `@import(...)` (a file
// import cannot cross a package boundary). Judged by `zoning verify`.

package relate {
    // root.zig is the module's public face: it re-exports every tier for the
    // product packages and aggregates the test step, so it alone may reach
    // anywhere.
    root   src
    facade root.zig
}

// Tiers, low to high. An import may only point back up the page.
zones {
    // Source anatomy — comment spans, identifier tokens, structural leans:
    // how a file decomposes into comparison units. Pure compute.
    anatomy     kernel/anatomy/**

    // Compression-as-similarity: sketches, silhouettes, recall, clustering —
    // the metrics and their calibration (grade bands, noise floors).
    kinship     kernel/kinship/**

    // The Ziv–Merhav corpus-quotation parse (cento) over the library's
    // FM-index. The index itself and its shelf moved into `irregex` — this
    // tier is only the parse that turns that index into a quotation.
    codex       kernel/codex/**

    // Set algebra over candidate sets — the composition tier (exact ∩
    // compression, the blast/provenance kernels), so it is the only kernel
    // tier allowed to know all the others.
    compose     kernel/compose/**

    // The persisted kinship artifacts — the atlas and the fragment atlas.
    // Built by the metrics below, trusted through irregex's freshness fold.
    // (The codex shelf moved into `irregex` with the FM-index it wraps.)
    artifacts   corpus/index/**

    // Kinship retrieval over the persisted artifacts — the path `relate
    // similar`/`pack` ride, shared by cold and warm transports.
    retrieval   exec/retrieval/**

    // The warm-session leg of retrieval — the fingerprint lexicon the
    // resident tier keeps hot, riding the cold retrieval path above.
    warm        exec/session/**

    // Shared flag, grade, manifest and answer-keep vocabulary — the floor the
    // face stands on. (`reprise.zig` is the answer keep's CLI half; it dials
    // gist's daemon through `@import("gist")`, never a file import across
    // the package boundary.)
    cli         surface/cli/**

    // C-ABI producer — `relate_run` over kinship / retrieval / sweep. Sits
    // above the engine tiers it dispatches into and beside the face: Zig
    // callers take the face or the kernels; non-Zig callers take this. The
    // export shims (`exports.zig`) are the artifact root, not a consumer of
    // this tier from inside the package — only root may import it, so the
    // module never re-emits the C symbols into dependents.
    ffi         surface/ffi/**

    // The thin product face. A face imports the CLI vocabulary and the
    // engine; the engine never imports a face except through root's
    // re-export shelf.
    face        surface/face/**
}

// Reach outside the package: the modules the build graph hands us.
//
// Everything above orders what this package owns. These are the only names it
// says that it does not, and each is a dependency `build.zig` has to satisfy.
// `std`, `builtin` and `root` are the language's, granted without asking.

// The engine, everywhere: corpus walk, scope, JSON escaping, the FM-index this
// package's quoter reads. A file import cannot cross a package boundary, so
// every zone reaches it by module name.
use irregex

// The version string, injected by `b.addOptions`.
use build_options

// The resident daemon and the answer keep live in the product chassis, and only
// the two callers that dial it need it: the face, and `cli/reprise.zig`, which
// is the recall path itself.
use gist by cli face

// A face dispatches through this package's own module rather than by path: a
// binary's root file is its own module root, so relative imports beneath it
// would not resolve. It reads as a self-import because it is one.
use relate by face

// Guest lists: regions only the named importers may reach at all.

// The face is this package's one product surface. Nothing else in the tree
// reaches into it; a helper both the face and the engine need belongs under
// them, not in the face.
keep surface/face/** to root.zig

// The C-ABI plane is the package's other public face — for callers outside
// Zig. Nothing inside the package consumes its own FFI shims; a Zig caller
// that wants kinship takes the kernels, which is what ffi does.
keep surface/ffi/** to root.zig

// Tests are consumers of the architecture, never load-bearing in it.
keep **/*_test.zig to root.zig

// The kinship atlas is a persisted format — callers get the reader, never the
// on-disk layout.
seal corpus/index/atlas through atlas.zig

// The fragment atlas, same contract as its sibling atlas.
seal corpus/index/frag through frag.zig

// Structural laws.
limit  reach to 5 hops
forbid cycles across directories
